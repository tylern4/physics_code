# Keep the build context to source only.
#
# The image builds everything itself (C++ executables, the MAID Cython
# extension, and a fresh virtualenv), so none of these need to be sent or
# copied in. In particular .venv is host-architecture specific and would
# silently shadow the one built in the image.

# virtualenvs
.venv/
venv/

# build trees -- rebuilt inside the image
build/
_build/
external/aao_rad_lund/build/
external/lz4xx/
external/zstr/
cmake-build-*/

# version control
.git/
.gitignore

# data: mounted at run time, never baked in (tens of GB of ROOT files)
data/exp/
data/sim/
data/MomCorr/

# scratch outputs and multi-GB intermediate CSVs
xsec_work/
original_vs_fixed/
analysis_tools/
*.csv
*.csv.gz
*.root
*.log

# results are regenerated by the container
xsec_results/

# editor / OS noise
.DS_Store
*.swp
__pycache__/
*.pyc
*.o
*.so
*.dylib
